# Template variabel jaringan.
# File .env asli akan dibuat otomatis dengan mendeteksi router saat Anda menjalankan:
# bash src/init-network.sh

# Nama interface jaringan host yang aktif (contoh: wlp3s0, eth0, wlan0)
PARENT_IFACE=

# Subnet jaringan lokal router (contoh: 192.168.1.0/24, 10.0.0.0/24)
SUBNET=

# Alamat IP gateway router (contoh: 192.168.1.1, 10.0.0.1)
GATEWAY=

# Alamat IP khusus yang akan dialokasikan untuk VPS (contoh: 192.168.1.150)
VPS_IP=
